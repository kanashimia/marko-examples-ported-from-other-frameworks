server function getTutorials() {
  const posts = import.meta.glob("#src/routes/_tutorials/**/*+page.marko", {
    query: "?raw",
    import: "default",
    eager: true,
  });

  return Object.keys(posts)
    .map(x => x.match(/.*\/(.+)\+page.marko/)[1])
    .sort()
}

<main>
  <ul>
    <for |path| of=getTutorials()>
      <li><a href=`/${path}`>${path}</a></li>
    </for>
  </ul>
</main>
