<define/Counter>
  <let/count=0/>
  <const/increment() {
    count = count + 1
  }/>
  <const/doubleCount=(count * 2)/>
  <return={ count, doubleCount, increment }/>
</define>

<Counter /{ count, doubleCount, increment } />

<button type="button" onClick=increment>
  ${count} ${doubleCount}
</button>
